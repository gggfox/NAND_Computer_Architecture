{
  "name": "nand-computer-architecture",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node scripts/build-pwa.ts",
    "preview": "vite preview",
    "i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/i18n/paraglide --strategy localStorage preferredLanguage baseLocale --emit-ts-declarations --silent",
    "css-types": "vite-css-modules \"src/**/*.module.css\" --silent",
    "tokens": "node scripts/generate-theme-css.ts",
    "typecheck": "pnpm i18n && pnpm css-types && tsc --noEmit && tsc --noEmit -p scripts && tsc --noEmit -p e2e",
    "lint": "oxlint --type-aware --deny-warnings --ignore-pattern 'tooling/lint-canaries/**'",
    "lint:canaries": "node scripts/check-lint-canaries.ts",
    "test": "vitest run --coverage",
    "e2e": "playwright test --grep-invert @visual",
    "e2e:visual": "playwright test --project=chromium --grep @visual",
    "e2e:visual:docker": "docker run --rm --ipc=host -v \"$PWD\":/work -v /work/node_modules -w /work -e CI=1 -e npm_config_use_node_version=26.12.1 mcr.microsoft.com/playwright:v1.64.1-noble bash -c 'npm install --global pnpm@10.25.0 && pnpm install --frozen-lockfile --ignore-scripts && if [ \"$1\" = -- ]; then shift; fi; pnpm e2e:visual \"$@\"' e2e-visual",
    "lint:css": "stylelint \"src/**/*.css\"",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "spell": "cspell --no-progress --gitignore",
    "check": "pnpm typecheck && pnpm lint && pnpm lint:css && pnpm format:check && pnpm knip && pnpm spell && pnpm lint:canaries && pnpm test",
    "prepare": "lefthook install || true"
  },
  "dependencies": {
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-start": "catalog:",
    "idb": "catalog:",
    "react": "catalog:",
    "react-aria-components": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@babel/core": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@commitlint/types": "catalog:",
    "@cspell/dict-es-es": "catalog:",
    "@double-great/stylelint-a11y": "catalog:",
    "@inlang/paraglide-js": "catalog:",
    "@playwright/test": "catalog:",
    "@rolldown/plugin-babel": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "cspell": "catalog:",
    "eslint-import-resolver-typescript": "catalog:",
    "eslint-plugin-boundaries": "catalog:",
    "eslint-plugin-sonarjs": "catalog:",
    "fake-indexeddb": "catalog:",
    "knip": "catalog:",
    "lefthook": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "stylelint": "catalog:",
    "stylelint-config-css-modules": "catalog:",
    "stylelint-config-recess-order": "catalog:",
    "stylelint-config-standard": "catalog:",
    "stylelint-declaration-strict-value": "catalog:",
    "stylelint-high-performance-animation": "catalog:",
    "stylelint-order": "catalog:",
    "stylelint-plugin-use-baseline": "catalog:",
    "stylelint-use-logical": "catalog:",
    "stylelint-value-no-unknown-custom-properties": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-css-modules": "catalog:",
    "vitest": "catalog:",
    "workbox-build": "catalog:"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@10.25.0"
}
