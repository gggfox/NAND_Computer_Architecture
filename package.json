{
  "name": "nand-computer-architecture",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "css-types": "vite-css-modules \"src/**/*.module.css\" --silent",
    "typecheck": "pnpm css-types && tsc --noEmit && tsc --noEmit -p scripts",
    "lint": "oxlint --type-aware --deny-warnings --ignore-pattern 'tooling/lint-canaries/**'",
    "lint:canaries": "node scripts/check-lint-canaries.ts",
    "test": "vitest run --coverage",
    "lint:css": "stylelint \"src/**/*.css\"",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "spell": "cspell --no-progress --gitignore",
    "check": "pnpm typecheck && pnpm lint && pnpm lint:css && pnpm format:check && pnpm knip && pnpm spell && pnpm lint:canaries && pnpm test",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-start": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@commitlint/types": "catalog:",
    "@cspell/dict-es-es": "catalog:",
    "@double-great/stylelint-a11y": "catalog:",
    "@rolldown/plugin-babel": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "cspell": "catalog:",
    "eslint-import-resolver-typescript": "catalog:",
    "eslint-plugin-boundaries": "catalog:",
    "eslint-plugin-sonarjs": "catalog:",
    "knip": "catalog:",
    "lefthook": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "stylelint": "catalog:",
    "stylelint-config-css-modules": "catalog:",
    "stylelint-config-recess-order": "catalog:",
    "stylelint-config-standard": "catalog:",
    "stylelint-declaration-strict-value": "catalog:",
    "stylelint-high-performance-animation": "catalog:",
    "stylelint-order": "catalog:",
    "stylelint-plugin-use-baseline": "catalog:",
    "stylelint-use-logical": "catalog:",
    "stylelint-value-no-unknown-custom-properties": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-css-modules": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@10.25.0"
}
