{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/routes/**/*.{ts,tsx}",
    "src/features/*/index.ts",
    "src/features/simulation/adapters/engine.worker.ts",
    "src/shared/ui/index.ts",
    "src/**/*.test.{ts,tsx}",
    "scripts/*.ts",
    "tooling/lint-rules/index.js"
  ],
  "project": ["src/**", "scripts/**", "tooling/lint-rules/**"],
  "ignoreDependencies": [
    "@inlang/plugin-message-format",
    "@fontsource-variable/orbitron",
    "@fontsource/chakra-petch"
  ]
}
